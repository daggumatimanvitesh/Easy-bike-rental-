DB_URL=jdbc:mysql://localhost:3306/easy_bike_rentals_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_user
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=2592000000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
VITE_API_TARGET=http://localhost:8080
# Optional Razorpay Test Mode only; keep secret values server-side and out of Git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEMO_PAYMENTS_ENABLED=true
# Required for real email verification delivery. Configure these in the backend run environment.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=verified-sender@example.com
MAIL_AUTH=true
MAIL_STARTTLS=true
FRONTEND_BASE_URL=http://127.0.0.1:5174
